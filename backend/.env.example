# ==========================================
# KharchaSense Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Option A: MongoDB Atlas (Cloud Database - Recommended)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/kharchasense?retryWrites=true&w=majority

# Option B: Local MongoDB Instance (Alternative)
# MONGO_URI=mongodb://127.0.0.1:27017/kharchasense

# Security & Authentication (JSON Web Token)
# Secret key used for signing and verifying authentication tokens (minimum 32 characters in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration (Client Application URL)
# Specifies the frontend application URL for CORS headers
FRONTEND_URL=http://localhost:5173
